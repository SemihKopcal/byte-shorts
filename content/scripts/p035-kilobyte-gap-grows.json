 "facts": [
  {
   "claim": "NIST defines the binary prefix kibi as 2^10 = 1024, and in the SI one kilo means 1000 (1 kbit = 1000 bit)",
   "source": 0,
   "note": "NIST, Definitions of the SI units: the binary prefixes: Ki = 2^10 = 1024; 1 kbit = 10^3 bit = 1000 bit"
  },
  {
   "claim": "The SI kilobyte is 1000 bytes, while in some contexts such as RAM kilobyte often meant 1024 bytes; the kibibyte (1024 bytes) was created to remove the ambiguity",
   "source": 1,
   "note": "Wikipedia, Kilobyte: SI 1000 bytes; kibibyte defined as 1024 bytes avoiding the ambiguity"
  }
 ],
